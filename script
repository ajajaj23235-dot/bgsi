-- tries every reward (1..CLAIM_COUNT) once; returns how many the server answered "truthy" to
local function claimRound(token)
	local ok = 0
	for i = 1, CLAIM_COUNT do
		if not (autoClaim and claimToken == token) then return ok end
		setClaimStatus(string.format("Claiming reward %d/%d...", i, CLAIM_COUNT))
		local success, result = pcall(Func.InvokeServer, Func, "ClaimPlaytime", i)
		if success and result then
			ok += 1
			print("[zey] ClaimPlaytime", i, result)
		end
		task.wait(CLAIM_GAP)
	end
	return ok
end

local function startClaim()
	claimToken += 1
	local token = claimToken
	task.spawn(function()
		while autoClaim and claimToken == token do
			local ok = claimRound(token)
			local nextAt = os.clock() + CLAIM_INTERVAL
			while autoClaim and claimToken == token and os.clock() < nextAt do
				setClaimStatus(string.format("Next claim in %ds  (last round: %d ok)", math.ceil(nextAt - os.clock()), ok))
				task.wait(0.25)
			end
		end
	end)
end

