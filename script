rejoinBtn.MouseButton1Click:Connect(function()
	-- stop everything first so nothing keeps firing while the teleport starts
	autoBubble = false
	autoHatch = false
	bubbleToken += 1
	hatchToken += 1
	autoClaim = false
	claimToken += 1
	stopEnchant()
	cancelTween()
	local hrp = getHRP()
	if hrp then hrp.Anchored = false end

	local TeleportService = game:GetService("TeleportService")
	-- same server first; if that fails (server full / closed / Studio), join any server of the game
	local ok = pcall(TeleportService.TeleportToPlaceInstance, TeleportService, game.PlaceId, game.JobId, player)
	if not ok then
		pcall(TeleportService.Teleport, TeleportService, game.PlaceId, player)
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	autoBubble = false
	autoHatch = false
	bubbleToken += 1
	hatchToken += 1
	autoClaim = false
	claimToken += 1
	pcall(function()
		ContextActionService:UnbindAction(WHEEL_ACTION)
	end)
