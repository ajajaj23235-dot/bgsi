-- Dropdown (egg / rift): sunken "combo box" with a raised arrow button.
-- The window grows because the panel's list layout follows the dropdown frame's height.
local DD_BUTTON_HEIGHT = 32
local DD_GAP = 4
local DD_ROW = 27
local DD_MIN_LIST = 34
local DD_MAX_LIST = 92 -- about 3 rows visible, scroll for more
local DD_TWEEN = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FIELD_HOVER = Color3.fromRGB(255, 230, 245)

-- After a dropdown opens, nudge the panel so the whole list is visible
local function revealInPanel(frame)
	local sf = frame.Parent
	if not (sf and sf:IsA("ScrollingFrame")) then return end
	task.delay(DD_TWEEN.Time + 0.03, function()
		if not frame.Parent then return end
		local view = sf.AbsoluteWindowSize.Y
		local maxY = math.max(0, sf.AbsoluteCanvasSize.Y - view)
		local top = frame.AbsolutePosition.Y - sf.AbsolutePosition.Y + sf.CanvasPosition.Y
		local bottom = top + frame.AbsoluteSize.Y
		local want = math.clamp(math.min(bottom - view + 6, top), 0, maxY)
		if want > sf.CanvasPosition.Y then
			TweenService:Create(sf, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				CanvasPosition = Vector2.new(0, want),
			}):Play()
		end
	end)
end

local dropdowns = {}

local function makeDropdown(parent, order, prefix, emptyText, onPick)
	local d = { open = false, instMap = {}, btns = {}, suffix = {}, selected = nil }

	local frame = Instance.new("Frame")
	frame.Name = prefix .. "Dropdown"
	frame.LayoutOrder = order
	frame.Size = UDim2.new(1, 0, 0, DD_BUTTON_HEIGHT)
	frame.BackgroundTransparency = 1
	frame.ZIndex = 5
	frame.Parent = parent

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, DD_BUTTON_HEIGHT)
	btn.BackgroundColor3 = INSET
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = ""
	btn.ZIndex = 5
	btn.Parent = frame
	local btnStroke = stroke(btn, OUTLINE, 2)
	bevel(btn, false, 2)

	local txt = Instance.new("TextLabel")
	txt.BackgroundTransparency = 1
	txt.Position = UDim2.fromOffset(10, 0)
	txt.Size = UDim2.new(1, -44, 1, 0)
	txt.Font = FONT_SMALL
	txt.TextSize = 14
	txt.TextColor3 = TEXT_DARK
	txt.TextXAlignment = Enum.TextXAlignment.Left
	txt.TextTruncate = Enum.TextTruncate.AtEnd
	txt.Text = prefix .. emptyText
	txt.ZIndex = 7
	txt.Parent = btn

	local arrowBox = Instance.new("Frame")
	arrowBox.AnchorPoint = Vector2.new(1, 0.5)
	arrowBox.Position = UDim2.new(1, -5, 0.5, 0)
	arrowBox.Size = UDim2.fromOffset(24, DD_BUTTON_HEIGHT - 12)
	arrowBox.BackgroundColor3 = FACE
	arrowBox.BorderSizePixel = 0
	arrowBox.ZIndex = 7
	arrowBox.Parent = btn
	bevel(arrowBox, true, 2)

	local arrow = Instance.new("TextLabel")
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.new(1, 0, 1, 0)
	arrow.Font = FONT_MAIN
	arrow.TextSize = 14
	arrow.TextColor3 = TEXT_DARK
	arrow.Text = "v"
	arrow.ZIndex = 9
	arrow.Parent = arrowBox

	local list = Instance.new("ScrollingFrame")
	list.Position = UDim2.new(0, 0, 0, DD_BUTTON_HEIGHT + DD_GAP)
	list.Size = UDim2.new(1, 0, 0, 0)
	list.BackgroundColor3 = INSET
	list.BorderSizePixel = 0
	list.Visible = false
	list.ScrollBarThickness = 8
	list.ScrollBarImageColor3 = PINK
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ClipsDescendants = true
	list.ZIndex = 5
	list.Parent = frame
	stroke(list, OUTLINE, 2)
	registerWheel(list, DD_ROW) -- one notch = exactly one row

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 3)
	pad.PaddingBottom = UDim.new(0, 3)
	pad.PaddingLeft = UDim.new(0, 3)
	pad.PaddingRight = UDim.new(0, 3)
	pad.Parent = list

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 3)
	layout.SortOrder = Enum.SortOrder.Name
	layout.Parent = list

	d.frame, d.button, d.stroke = frame, btn, btnStroke

	local function count()
		local n = 0
		for _ in pairs(d.instMap) do n += 1 end
		return n
	end
	d.count = count

	function d.listHeight()
		return math.clamp(count() * DD_ROW + 6, DD_MIN_LIST, DD_MAX_LIST)
	end

	local function recolor()
		for name, b in pairs(d.btns) do
			local sel = (name == d.selected)
			b.BackgroundColor3 = sel and SELECT or INSET
			b.TextColor3 = sel and WHITE or TEXT_DARK
		end
	end

	function d.updateText()
		local text
		if d.selected then
			text = d.selected .. (d.suffix[d.selected] or "")
		elseif count() > 0 then
			text = "choose"
		else
			text = emptyText
		end
		txt.Text = prefix .. text
	end

	function d.select(name)
		d.selected = name
		d.updateText()
		recolor()
	end

	function d.setOpen(open)
		d.open = open
		arrow.Text = open and "^" or "v"
		if open then
			list.Visible = true
			local h = d.listHeight()
			TweenService:Create(list, DD_TWEEN, { Size = UDim2.new(1, 0, 0, h) }):Play()
			TweenService:Create(frame, DD_TWEEN, { Size = UDim2.new(1, 0, 0, DD_BUTTON_HEIGHT + DD_GAP + h) }):Play()
			revealInPanel(frame)
		else
			local t = TweenService:Create(list, DD_TWEEN, { Size = UDim2.new(1, 0, 0, 0) })
			t:Play()
			TweenService:Create(frame, DD_TWEEN, { Size = UDim2.new(1, 0, 0, DD_BUTTON_HEIGHT) }):Play()
			t.Completed:Once(function()
				if not d.open then
					list.Visible = false
				end
			end)
		end
	end

	-- Extra text shown after an item's name (e.g. luck) + sort rank (lower = higher in list)
	function d.setMeta(name, suffixText, rank)
		d.suffix[name] = suffixText or ""
		local b = d.btns[name]
		if b then
			b.Text = " " .. name .. (suffixText or "")
			b.Name = string.format("%07d_%s", rank or 0, name)
		end
		if d.selected == name then
			d.updateText()
		end
	end

	function d.add(name, inst)
		d.instMap[name] = inst
		if d.btns[name] then return end

		local b = Instance.new("TextButton")
		b.Name = name
		b.Size = UDim2.new(1, 0, 0, 24)
		b.BackgroundColor3 = INSET
		b.BorderSizePixel = 0
		b.AutoButtonColor = false
		b.Font = FONT_SMALL
		b.TextSize = 13
		b.TextColor3 = TEXT_DARK
		b.TextTruncate = Enum.TextTruncate.AtEnd
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.Text = " " .. name .. (d.suffix[name] or "")
		b.ZIndex = 6
		b.Parent = list

		b.MouseEnter:Connect(function()
			if d.selected ~= name then
				b.BackgroundColor3 = SELECT_HOVER
			end
		end)
		b.MouseLeave:Connect(function()
			if d.selected ~= name then
				b.BackgroundColor3 = INSET
			end
		end)
		b.MouseButton1Click:Connect(function()
			d.select(name)
			d.setOpen(false)
			onPick(d, name)
		end)

		d.btns[name] = b
		recolor()
	end

	function d.remove(name)
		d.instMap[name] = nil
		d.suffix[name] = nil
		if d.btns[name] then
			d.btns[name]:Destroy()
			d.btns[name] = nil
		end
		if d.selected == name then
			d.selected = nil
		end
	end

	btn.MouseButton1Click:Connect(function()
		local opening = not d.open
		if opening then
			for _, other in ipairs(dropdowns) do
				if other ~= d and other.open then
					other.setOpen(false)
				end
			end
		end
		d.setOpen(opening)
	end)
	btn.MouseEnter:Connect(function()
		btn.BackgroundColor3 = FIELD_HOVER
	end)
	btn.MouseLeave:Connect(function()
		btn.BackgroundColor3 = INSET
	end)

	table.insert(dropdowns, d)
	return d
end

