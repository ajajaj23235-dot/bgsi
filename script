			chip:SetAttribute("NoTheme", true)
			chip.Parent = b
			local chipStroke = stroke(chip, theme.OUTLINE, 1)
			chipStroke:SetAttribute("NoTheme", true)
		end

		table.insert(themeButtons, { theme = theme, label = l })

		b.MouseEnter:Connect(function()
			TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = FACE_HOVER }):Play()
		end)
		b.MouseLeave:Connect(function()
			bv.set(true)
			TweenService:Create(b, TweenInfo.new(0.1), { BackgroundColor3 = FACE }):Play()
		end)
		b.MouseButton1Down:Connect(function()
			bv.set(false)
		end)
		b.MouseButton1Up:Connect(function()
			bv.set(true)
		end)
		b.MouseButton1Click:Connect(function()
			burst(b)
			applyTheme(theme)
			refreshThemeButtons()
			save()
		end)
	end

	---------------------------------------------------------------------
	-- Open / close the panel
	---------------------------------------------------------------------
	local open = false
	gearBtn.MouseEnter:Connect(function()
		TweenService:Create(gearBtn, TweenInfo.new(0.1), { BackgroundColor3 = BLUE }):Play()
		gearCenter.BackgroundColor3 = BLUE
		TweenService:Create(gear, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 90 }):Play()
	end)
	gearBtn.MouseLeave:Connect(function()
		gearBevel.set(not open)
		TweenService:Create(gearBtn, TweenInfo.new(0.1), { BackgroundColor3 = FACE }):Play()
		gearCenter.BackgroundColor3 = FACE
		TweenService:Create(gear, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	end)
	gearBtn.MouseButton1Click:Connect(function()
		open = not open
		panel.Visible = open
		gearBevel.set(not open)
	end)

	---------------------------------------------------------------------
	-- Restore what was saved last time
	---------------------------------------------------------------------
	updateSlider()
	refreshThemeButtons()

	local saved = loadSaved()
	if saved then
		for _, theme in ipairs(THEMES) do
			if theme.name == saved.theme then
				applyTheme(theme)
				refreshThemeButtons()
				break
			end
		end
		if type(saved.fps) == "number" then
			applyFps(saved.fps)
		end
	end
end)()

