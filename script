	local stateLabel = Instance.new("TextLabel")
	stateLabel.BackgroundTransparency = 1
	stateLabel.AnchorPoint = Vector2.new(1, 0)
	stateLabel.Position = UDim2.new(1, -10, 0, 0)
	stateLabel.Size = UDim2.new(0, 44, 1, 0)
	stateLabel.Font = FONT_SMALL
	stateLabel.TextSize = 14
	stateLabel.TextColor3 = LED_OFF
	stateLabel.TextXAlignment = Enum.TextXAlignment.Right
	stateLabel.Text = "OFF"
	stateLabel.ZIndex = 7
	stateLabel.Parent = btn

	local state = false
	local hovering = false
	local emitToken = 0

	local function paint()
		TweenService:Create(btn, TweenInfo.new(0.1), {
			BackgroundColor3 = state and MINT or (hovering and FACE_HOVER or FACE),
		}):Play()
	end

	local function set(value)
		state = value
		stateLabel.Text = state and "ON" or "OFF"
		stateLabel.TextColor3 = state and Color3.fromRGB(20, 120, 60) or LED_OFF
		led.BackgroundColor3 = state and LED_ON or LED_OFF
		bv.set(not state)
		paint()

		emitToken += 1
		local token = emitToken
		if state then
			task.spawn(function()
				while state and emitToken == token and btn.Parent do
					emitBubble(btn)
					task.wait(0.22)
				end
			end)
		end
	end

	btn.MouseEnter:Connect(function()
		hovering = true
		paint()
	end)
	btn.MouseLeave:Connect(function()
		hovering = false
		bv.set(not state)
		paint()
	end)
	btn.MouseButton1Down:Connect(function()
		bv.set(false)
	end)
	btn.MouseButton1Click:Connect(function()
		burst(btn)
		set(not state)
		onChange(state)
	end)

	return btn, set
end

