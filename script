local ready = false
local resizeLock = false

local function viewHeight(name)
	local p = panels[name]
	return math.min(p.layout.AbsoluteContentSize.Y + PANEL_PAD * 2, p.maxH)
end

local function applyPanelSize(name)
	panels[name].frame.Size = UDim2.new(1, -21, 0, viewHeight(name))
end

local function targetHeight()
	return TOP - PANEL_PAD + viewHeight(active) + 13
end

local function resizeMain()
	if ready and not resizeLock then
		applyPanelSize(active)
		main.Size = UDim2.fromOffset(GUI_WIDTH, targetHeight())
	end
end

local function makePanel(name, maxH)
	local frame = Instance.new("ScrollingFrame")
	frame.Name = name
	frame.Position = UDim2.new(0, 13, 0, TOP - PANEL_PAD)
	frame.Size = UDim2.new(1, -21, 0, 0)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.ZIndex = 5
	frame.Visible = false
	frame.CanvasSize = UDim2.new()
	frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	frame.ScrollingDirection = Enum.ScrollingDirection.Y
	frame.ScrollBarThickness = 8
	frame.ScrollBarImageColor3 = PINK
	frame.ClipsDescendants = true
	frame.Parent = main
	registerWheel(frame, PANEL_STEP)

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, PANEL_PAD)
	pad.PaddingBottom = UDim.new(0, PANEL_PAD)
	pad.PaddingLeft = UDim.new(0, PANEL_PAD)
	pad.PaddingRight = UDim.new(0, 12)
	pad.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 7)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = frame

	panels[name] = { frame = frame, layout = layout, maxH = maxH }

	table.insert(connections, layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		if active == name then
			resizeMain()
		end
	end))

	return frame
end

