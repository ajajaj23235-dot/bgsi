-- (re)build the list from everything the scan found + anything already picked.
-- Leveled enchants get one row per level, everything else gets a single row (level 1).
rebuildWantList = function()
	local keys = {}
	for id in pairs(allEnchants) do
		if not isProtectedEnchant(id) then -- special ones can't be rolled, so not pickable
			for lvl = 1, (LEVELED[id] or 1) do
				keys[keyOf(id, lvl)] = true
			end
		end
	end
	for _, k in ipairs(wantedList) do keys[k] = true end

	for k, b in pairs(wantRows) do
		if not keys[k] then
			b:Destroy()
			wantRows[k] = nil
		end
	end
	for k in pairs(keys) do
		if not wantRows[k] then makeWantRow(k) end
	end
	repaintWanted()
	if wantDDOpen then setWantOpen(true) end -- resize for the new item count
end
rebuildWantList()
end -- end of wanted picker block

