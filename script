local autoBubble = false
local autoHatch = false
local bubbleToken = 0
local hatchToken = 0

local function startBubble()
	bubbleToken += 1
	local token = bubbleToken
	task.spawn(function()
		while autoBubble and bubbleToken == token do
			fire("BlowBubble")
			task.wait(BUBBLE_DELAY)
		end
	end)
end

-- Auto hatch
local function startHatch()
	hatchToken += 1
	local token = hatchToken

	-- Movement + HatchEgg remote loop
	task.spawn(function()
		while autoHatch and hatchToken == token do
			local eggName = target.name
			local egg = getTargetInstance()

			if not egg or not egg.Parent then
				setFarmStatus("No egg selected")
				task.wait(0.5)
			else
				local hrp = getHRP()
				local pos = getInstancePosition(egg)
				if hrp and pos then
					if (hrp.Position - pos).Magnitude > HATCH_RANGE then
						setFarmStatus("Moving to " .. eggName .. "...")
						tweenTo(pos + STAND_OFFSET)
					end
					if autoHatch and hatchToken == token then
						setFarmStatus("Hatching " .. eggName)
						fire("HatchEgg", eggName, HATCH_AMOUNT)
					end
				end
				task.wait(HATCH_DELAY)
			end
		end
	end)

	-- E / R key spam
	task.spawn(function()
		while autoHatch and hatchToken == token do
			for _, key in ipairs(KEYS) do
				tapKey(key)
			end
			task.wait(KEY_DELAY)
		end
	end)
end

