-- Pet cache (filled from PetsDelta events)
---------------------------------------------------------------------
local pets = {}   -- [petId] = { Id, Name, Shiny, Enchants = { {Id=, Level=}, ... }, ... }
local stamp = {}  -- [petId] = counter, bumped every time the server sends that pet

local function applyEntry(entry)
	if type(entry) ~= "table" or not entry.Id then return end
	local cur = pets[entry.Id]
	if not cur then
		cur = {}
		pets[entry.Id] = cur
	end
	for k, v in pairs(entry) do
		cur[k] = v
	end
	stamp[entry.Id] = (stamp[entry.Id] or 0) + 1
end

table.insert(connections, Event.OnClientEvent:Connect(function(kind, data)
	if kind ~= "PetsDelta" or type(data) ~= "table" then return end
	for _, list in ipairs({ data.Changed or {}, data.Added or {} }) do
		for _, entry in pairs(list) do
			applyEntry(entry)
		end
	end
	for _, r in pairs(data.Removed or {}) do
		local id = type(r) == "table" and r.Id or r
		if id ~= nil then
			pets[id] = nil
		end
	end
end))

---------------------------------------------------------------------
-- Equipped pets (read from the game's local data module)
-- If the Enchant tab says it can't read your equipped pets, press "Dump"
-- and check the output (F9).
---------------------------------------------------------------------
local function loadLocalData()
	local ok, data = pcall(function()
		local svc = ReplicatedStorage:WaitForChild("Client", 2).Framework.Services.LocalData
		return require(svc):Get()
	end)
	if ok and type(data) == "table" then
		return data
	end
	return nil
end

local function idsFrom(list)
	local out = {}
	if type(list) ~= "table" then return out end
	for _, v in pairs(list) do
		if type(v) == "string" then
			table.insert(out, v)
		elseif type(v) == "table" and v.Id then
			table.insert(out, v.Id)
		end
	end
	return out
end

local function seedFromData(data, ids)
	local missing = false
	for _, id in ipairs(ids) do
		if not pets[id] then missing = true break end
	end
	if not missing or type(data.Pets) ~= "table" then return end
	for k, v in pairs(data.Pets) do
		if type(v) == "table" then
			local id = v.Id or (type(k) == "string" and k)
			if id and not pets[id] then
				local copy = {}
				for kk, vv in pairs(v) do copy[kk] = vv end
				copy.Id = id
				pets[id] = copy
			end
		end
	end
end

local function getEquippedIds()
	local data = loadLocalData()
	if not data then return nil end

	local ids = {}
	local idx = data.TeamEquipped or data.EquippedTeam or data.CurrentTeam
	local team = type(data.Teams) == "table" and idx and data.Teams[idx]
	if team then
		ids = idsFrom(team.Pets or team)
	end
	if #ids == 0 then
		ids = idsFrom(data.EquippedPets or data.PetsEquipped or data.Equipped)
	end
	if #ids == 0 then return nil end

	seedFromData(data, ids)
	return ids
end

local function dumpData()
	local data = loadLocalData()
	if not data then
		print("[zey] LocalData module not found (ReplicatedStorage.Client.Framework.Services.LocalData)")
		return
	end
	local function walk(t, depth, prefix)
		local n = 0
		for k, v in pairs(t) do
			n += 1
			if n > 30 then print(prefix .. "...") break end
			if type(v) == "table" then
				print(prefix .. tostring(k) .. " = table")
				if depth < 2 and k ~= "Pets" then
					walk(v, depth + 1, prefix .. "  ")
				end
			else
				print(prefix .. tostring(k) .. " = " .. tostring(v))
			end
		end
	end
	print("[zey] ---- local data dump ----")
	walk(data, 0, "[zey] ")
	if type(data.Pets) == "table" then
		for k, p in pairs(data.Pets) do
			print("[zey] sample pet entry, key =", k)
			if type(p) == "table" then walk(p, 1, "[zey]   ") end
			break
		end
	end
end

