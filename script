-- Wanted entries are stored as "id:level" keys, e.g. "team-up:5" or "ultra-roller:1".
local function splitKey(key)
	local id, lvl = string.match(key, "^(.-):(%d+)$")
	if id then return id, tonumber(lvl) end
	return key, 1
end

local function keyOf(id, lvl)
	return id .. ":" .. lvl
end

local function keyLabel(key) -- what the picker shows
	local id, lvl = splitKey(key)
	if LEVELED[id] then return id .. " " .. lvl end
	return id
end

-- Picked in the Enchant tab (order = priority). Shiny pets only have 2 slots,
-- so for them only the first MAX_WANTED_SHINY picks count.
local wantedList = {}
for token in string.gmatch(DEFAULT_WANTED, "[^,]+") do
	local t = (string.gsub(token, "^%s*(.-)%s*$", "%1"))
	t = (string.gsub(string.lower(t), "%s+", "-"))
	if t ~= "" then
		local id, lvl = splitKey(t)
		table.insert(wantedList, keyOf(id, lvl))
	end
end

local function slotCapFor(pet)
	local cap = (pet and pet.Shiny) and MAX_WANTED_SHINY or math.huge
	local n = pet and pet.Enchants and #pet.Enchants or 0
	if n > 0 then cap = math.min(cap, n) end
	return cap
end

-- the enchants this particular pet has to end up with (set of "id:level" keys)
local function parseWanted(pet)
	local set = {}
	local cap = slotCapFor(pet)
	for i, key in ipairs(wantedList) do
		if i > cap then break end
		set[key] = true
	end
	return set
end

-- does this single enchant on the pet satisfy a wanted key?
local function levelOk(e, id, lvl)
	if e.Id ~= id then return false end
	local have = tonumber(e.Level) or 1
	if ACCEPT_HIGHER_LEVELS then
		return have >= lvl
	end
	return have == lvl
end

-- does this enchant satisfy ANY of the wanted keys?
local function matchesWanted(wanted, e)
	for key in pairs(wanted) do
		local id, lvl = splitKey(key)
		if levelOk(e, id, lvl) then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------
-- Special (protected) enchants
-- A pet holding any of these is NEVER rolled.
---------------------------------------------------------------------
local function isProtectedEnchant(id)
	id = string.lower(tostring(id))
	if PROTECTED_ENCHANTS[id] then return true end
	for _, prefix in ipairs(PROTECTED_PREFIXES) do
		if string.sub(id, 1, #prefix) == prefix then return true end
	end
	return false
end

-- returns the first special enchant id on this pet, or nil
local function specialEnchant(pet)
	for _, e in ipairs(pet and pet.Enchants or {}) do
		if isProtectedEnchant(e.Id) then
			return tostring(e.Id)
		end
	end
	return nil
end

-- Every enchant id we know about (this feeds the picker in the Enchant tab)
local allEnchants = {}

local function looksLikeId(k)
	return type(k) == "string" and #k >= 3 and #k <= 40 and string.match(k, "^[%l%d][%l%d%-_]*$") ~= nil
end

local function collectIds(tbl)
	local n = 0
	for k, v in pairs(tbl) do
		if type(v) == "table" then
			if looksLikeId(k) then
				if not allEnchants[k] then n += 1 end
				allEnchants[k] = true
			end
			if looksLikeId(v.Id) then
				if not allEnchants[v.Id] then n += 1 end
				allEnchants[v.Id] = true
			end
		end
	end
	return n
end

-- Scan: looks through the enchant data in ReplicatedStorage (and the pets you own), collects every
-- enchant id for the picker and adds every "super-" id to the protected list.
-- returns: newSpecialCount, pickableCount
local function scanSpecialEnchants()
	local added = 0
	local function consider(k)
		if type(k) == "string" and isProtectedEnchant(k) and not PROTECTED_ENCHANTS[k] then
			PROTECTED_ENCHANTS[k] = true
			added += 1
			print("[zey] special enchant found:", k)
		end
	end

	for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
		local lname = string.lower(d.Name)
		if string.find(lname, "enchant", 1, true) then
			print("[zey] enchant object:", d:GetFullName(), d.ClassName)
			local skip = string.find(lname, "fishing", 1, true) or string.find(lname, "builder", 1, true)
			if d:IsA("ModuleScript") then
				local ok, mod = pcall(require, d)
				if ok and type(mod) == "table" then
					for k, v in pairs(mod) do
						consider(k)
						if type(v) == "table" then
							for k2 in pairs(v) do consider(k2) end
							consider(v.Id)
							consider(v.Name)
						end
					end
					if not skip then
						local n = collectIds(mod)
						if n == 0 then
							for _, v in pairs(mod) do
								if type(v) == "table" then n += collectIds(v) end
							end
						end
						print("[zey] enchant ids read from", d.Name, ":", n)
					end
				end
			else
				consider(d.Name)
			end
		end
	end

	-- enchants that are on pets we have seen / own
	local function fromPet(p)
		if type(p) ~= "table" then return end
		for _, e in ipairs(p.Enchants or {}) do
			if type(e) == "table" and looksLikeId(e.Id) then
				allEnchants[e.Id] = true
				consider(e.Id)
			end
		end
	end
	for _, p in pairs(pets) do fromPet(p) end
	local data = loadLocalData()
	if data and type(data.Pets) == "table" then
		for _, p in pairs(data.Pets) do fromPet(p) end
	end

	local total = 0
	for id in pairs(allEnchants) do
		if not isProtectedEnchant(id) then total += 1 end
	end
	if total == 0 then
		print("[zey] no pickable enchants found - send me the 'enchant object' lines above")
	end
	return added, total
end

-- Always run once on startup so newly added "super-" enchants are protected too
pcall(scanSpecialEnchants)

---------------------------------------------------------------------
-- Enchant logic
---------------------------------------------------------------------
-- returns "done", "protected", or "roll", keepSlot (keepSlot nil = nothing worth keeping yet)
local function analyze(id, pet, wanted)
	if specialEnchant(pet) then
		return "protected"
	end

	local enchants = pet.Enchants or {}
	if #enchants == 0 then
		return "roll", nil
	end

	-- every wanted "id:level" has to be satisfied by some enchant on the pet
	local missing = 0
	for key in pairs(wanted) do
		local wid, wlvl = splitKey(key)
		local ok = false
		for _, e in ipairs(enchants) do
			if levelOk(e, wid, wlvl) then
				ok = true
				break
			end
		end
		if not ok then missing += 1 end
	end
	if missing == 0 then
		return "done"
	end

	-- the game keeps ONE slot per roll: manual lock first, else the first slot holding a wanted enchant
	local keep = locks[id]
	if not (keep and enchants[keep]) then
		keep = nil
		for i, e in ipairs(enchants) do
			if matchesWanted(wanted, e) then
				keep = i
				break
			end
		end
	end
	return "roll", keep
end

-- turns "slot to keep" into whatever number the remote expects
local function slotArg(pet, keep)
	if SLOT_ARG_MODE == "keep" or not keep then
		return keep
	end
	for i = 1, #(pet.Enchants or {}) do
		if i ~= keep then return i end
	end
	return nil
end

-- true when this pet's wanted enchants include a secret one (= roll with crystals)
local function needsCrystal(wanted)
	for key in pairs(wanted) do
		local wid = splitKey(key)
		if SECRET_ENCHANTS[wid] then return true end
	end
	return false
end

local function rollOnce(id, slot, useCrystal)
	-- last-resort guard: never roll a pet that holds a special enchant
	if specialEnchant(pets[id]) then
		return false
	end

	local before = stamp[id] or 0
	if useCrystal then
		print("[zey] UseShadowCrystal", id, slot)
		fire("UseShadowCrystal", id, slot)
	else
		print("[zey] RerollEnchants (gems)", id, slot)
		-- InvokeServer yields, so run it on its own thread and wait for the PetsDelta below
		task.spawn(function()
			pcall(Func.InvokeServer, Func, "RerollEnchants", id, "Gems", slot)
		end)
	end
	local t = os.clock()
	while os.clock() - t < ROLL_TIMEOUT do
		if (stamp[id] or 0) ~= before then
			return true
		end
		task.wait(0.03)
	end
	return false
end

local function stopEnchant(msg)
	running = false
	runToken += 1
	if enchantSet then enchantSet(false) end
	if msg then setEnchantStatus(msg) end
end

local function runEnchant(token)
	local ids
	if onlySelected then
		ids = selectedId and { selectedId } or {}
	else
		ids = {}
		if selectedId then table.insert(ids, selectedId) end
		for _, id in ipairs(currentIds) do
			if id ~= selectedId then table.insert(ids, id) end
		end
	end
	if #ids == 0 then
		stopEnchant("No pets to enchant")
		return
	end
	if #wantedList == 0 then
		stopEnchant("Pick the enchants you want first")
		return
	end

	for _, id in ipairs(ids) do
		local rolls, fails = 0, 0
		while running and runToken == token do
			local pet = pets[id]
			if not pet then break end

			local wantedSet = parseWanted(pet)
			local state, keep = analyze(id, pet, wantedSet)
			local slot = slotArg(pet, keep)
			local useCrystal = needsCrystal(wantedSet)

			if state == "protected" then
				setEnchantStatus("Skipped (" .. tostring(specialEnchant(pet)) .. "): " .. petLabel(pet))
				task.wait(0.6) -- so you can read it
				break
			end

			if state == "done" then
				setEnchantStatus("Done: " .. petLabel(pet))
				break
			end

			rolls += 1
			if rolls > MAX_ROLLS_PER_PET then
				setEnchantStatus("Roll cap hit: " .. petLabel(pet))
				break
			end

			setEnchantStatus(string.format("%s - roll %d [%s] (keep slot %s)", petLabel(pet), rolls,
				useCrystal and "crystal" or "gems", tostring(keep or "none")))
			if rollOnce(id, slot, useCrystal) then
				fails = 0
			else
				fails += 1
				if fails >= MAX_FAILED then
					stopEnchant("No server reply - out of crystals?")
					return
				end
			end
			task.wait(ROLL_DELAY)
		end
		if not (running and runToken == token) then return end
		task.wait(0.2)
	end
	stopEnchant("Finished all pets")
end

