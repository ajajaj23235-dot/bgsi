-- Rift luck detection
-- I don't know where the game stores the luck multiplier, so this checks
-- every likely place: attributes, number values, and any text on the rift
-- (or on a BillboardGui attached to it) that looks like "x25" or "25x".
-- Press Refresh and check the output (F9) for a "rift debug" dump if it
-- shows x? for a rift.
local getRiftLuck, formatLuck, debugRift
do -- scoped so its locals don't count toward Lua's 200-locals limit
local luckCache = setmetatable({}, { __mode = "k" })

local function stripTags(s)
	return (string.gsub(s, "<[^>]->", ""))
end

local function parseMultiplier(text)
	text = stripTags(text)
	local n = string.match(text, "[xX]%s*(%d+%.?%d*)") or string.match(text, "(%d+%.?%d*)%s*[xX]")
	local hasLuck = string.find(string.lower(text), "luck", 1, true) ~= nil
	return tonumber(n), hasLuck
end

local function attrLuck(inst)
	for k, v in pairs(inst:GetAttributes()) do
		local lk = string.lower(k)
		if string.find(lk, "luck", 1, true) or string.find(lk, "multiplier", 1, true) then
			if type(v) == "number" then
				return v
			elseif type(v) == "string" then
				local n = tonumber(string.match(v, "%d+%.?%d*"))
				if n then return n end
			end
		end
	end
	return nil
end

local function isTextObject(inst)
	return inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")
end

local function scanForLuck(root, state)
	for _, d in ipairs(root:GetDescendants()) do
		local n = attrLuck(d)
		if n then return n end

		if (d:IsA("NumberValue") or d:IsA("IntValue")) and string.find(string.lower(d.Name), "luck", 1, true) then
			return d.Value
		end

		if isTextObject(d) then
			local m, hasLuck = parseMultiplier(d.Text)
			if m then
				if hasLuck then return m end
				state.fallback = state.fallback or m
			end
		end
	end
	return nil
end

function getRiftLuck(rift)
	if luckCache[rift] then
		return luckCache[rift]
	end

	local n = attrLuck(rift)
	local state = {}
	if not n then
		n = scanForLuck(rift, state)
	end

	if not n then
		-- BillboardGuis in PlayerGui that point at this rift
		for _, g in ipairs(player.PlayerGui:GetChildren()) do
			if g:IsA("BillboardGui") and g.Adornee and g.Adornee:IsDescendantOf(rift) then
				n = scanForLuck(g, state)
				if n then break end
			end
		end
	end

	n = n or state.fallback
	if n then
		luckCache[rift] = n
	end
	return n
end

function formatLuck(n)
	if n == math.floor(n) then
		return "x" .. tostring(math.floor(n))
	end
	return "x" .. tostring(n)
end

function debugRift(name, rift)
	print("[zey] rift debug:", name, "->", rift:GetFullName())
	local lines = 0
	local function out(...)
		if lines < 60 then
			print("   ", ...)
			lines += 1
		end
	end
	for k, v in pairs(rift:GetAttributes()) do
		out("attribute", k, v)
	end
	for _, d in ipairs(rift:GetDescendants()) do
		for k, v in pairs(d:GetAttributes()) do
			out("attribute", d:GetFullName(), k, v)
		end
		if isTextObject(d) then
			out("text", d:GetFullName(), d.Text)
		elseif d:IsA("ValueBase") then
			out("value", d:GetFullName(), d.Value)
		end
	end
	for _, g in ipairs(player.PlayerGui:GetChildren()) do
		if g:IsA("BillboardGui") and g.Adornee and g.Adornee:IsDescendantOf(rift) then
			for _, d in ipairs(g:GetDescendants()) do
				if isTextObject(d) then
					out("billboard text", d:GetFullName(), d.Text)
				end
			end
		end
	end
end
end -- end of luck detection block

-- Egg + rift scanning (only the two real folders)
local function getFolder(path)
	local node = workspace
	for _, n in ipairs(path) do
		node = node and node:FindFirstChild(n)
	end
	return node
end

local function isEggName(name)
	return string.find(string.lower(name), "egg", 1, true) ~= nil
end

local function riftDisplayName(raw)
	if RIFT_NAME_OVERRIDES[raw] then
		return RIFT_NAME_OVERRIDES[raw]
	end
	local s = string.gsub(raw, "[-_]", " ")
	s = string.gsub(s, "(%a)([%w]*)", function(a, b)
		return string.upper(a) .. string.lower(b)
	end)
	return s
end

local function collect(folder, nameFn)
	local found = {}
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if (child:IsA("Model") or child:IsA("BasePart"))
				and isEggName(child.Name)
				and getInstancePosition(child) then
				local name = nameFn and nameFn(child.Name) or child.Name
				if not found[name] then
					found[name] = child
				end
			end
		end
	end
	return found
end

local function sync(d, found)
	local changed = false

	local toRemove = {}
	for name, inst in pairs(d.instMap) do
		if found[name] ~= inst then
			table.insert(toRemove, name)
		end
	end
	for _, name in ipairs(toRemove) do
		if not found[name] then
			d.remove(name)
			changed = true
		else
			d.instMap[name] = found[name] -- same name, new instance (rift respawned)
		end
	end

	for name, inst in pairs(found) do
		if not d.btns[name] then
			d.add(name, inst)
			changed = true
		else
			d.instMap[name] = inst
		end
	end

	d.updateText()
	if changed and d.open then
		d.setOpen(true) -- resize list to new item count
	end
end

local function scanAll(verbose)
	local eggs = collect(getFolder(EGG_FOLDER_PATH), nil)
	local rifts = collect(getFolder(RIFT_FOLDER_PATH), riftDisplayName)

	sync(eggDD, eggs)
	sync(riftDD, rifts)

	-- Show luck next to each rift, highest luck first
	for name, inst in pairs(rifts) do
		local luck = getRiftLuck(inst)
		if luck then
			riftDD.setMeta(name, "  " .. formatLuck(luck), 999999 - math.floor(luck * 10))
		else
			riftDD.setMeta(name, "  x?", 999999)
		end
	end

	-- Default egg selection
	if not eggDD.selected then
		if eggDD.instMap["Infinity Egg"] then
			eggDD.select("Infinity Egg")
		else
			local names = {}
			for name in pairs(eggDD.instMap) do table.insert(names, name) end
			table.sort(names)
			if names[1] then eggDD.select(names[1]) end
		end
	end

	-- If nothing is the target yet, use the selected egg
	if not target.dd and eggDD.selected then
		setTarget(eggDD, eggDD.selected)
	end
	ensureTarget()

	if verbose then
		for name, inst in pairs(eggs) do
			print("[zey] egg:", name, "->", inst:GetFullName())
		end
		for name, inst in pairs(rifts) do
			print("[zey] rift:", name, "->", inst:GetFullName(), "luck:", getRiftLuck(inst))
			if not getRiftLuck(inst) then
				debugRift(name, inst)
			end
		end
		print("[zey] eggs:", eggDD.count(), "rifts:", riftDD.count())
	end

	return eggDD.count(), riftDD.count()
end

