-- Win98-style bevel: 4 thin lines on the inside edge of a frame.
-- raised = light top/left + dark bottom/right, sunken = the opposite.
local function bevel(parent, raised, w)
	w = w or 2
	local z = parent.ZIndex + 1
	local lines = {}
	local function line(name, pos, size)
		local f = Instance.new("Frame")
		f.Name = "Bevel" .. name
		f.BorderSizePixel = 0
		f.Position = pos
		f.Size = size
		f.ZIndex = z
		f.Parent = parent
		lines[name] = f
	end
	line("Top", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, w))
	line("Left", UDim2.new(0, 0, 0, 0), UDim2.new(0, w, 1, 0))
	line("Bottom", UDim2.new(0, 0, 1, -w), UDim2.new(1, 0, 0, w))
	line("Right", UDim2.new(1, -w, 0, 0), UDim2.new(0, w, 1, 0))

	local api = {}
	function api.set(isRaised)
		local hi = isRaised and BEVEL_LIGHT or BEVEL_SHADE
		local lo = isRaised and BEVEL_SHADE or BEVEL_LIGHT
		lines.Top.BackgroundColor3 = hi
		lines.Left.BackgroundColor3 = hi
		lines.Bottom.BackgroundColor3 = lo
		lines.Right.BackgroundColor3 = lo
	end
	api.set(raised)
	return api
end

