---------------------------------------------------------------------
-- Mouse wheel: small, exact steps (also used by the dropdown lists)
---------------------------------------------------------------------
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")

local WHEEL_ACTION = "ZeyBubbleGumWheel"
local PANEL_STEP = 40 -- px per wheel notch in the tab panels
local PANEL_PAD = 3
local wheelFrames = {}

local function registerWheel(frame, step)
	frame.ScrollingEnabled = false -- we handle the wheel ourselves: one small step per notch
	wheelFrames[frame] = { step = step }
end

local function depthOf(inst)
	local n = 0
	local p = inst.Parent
	while p do
		n += 1
		p = p.Parent
	end
	return n
end

local function mouseGuiPos()
	return UserInputService:GetMouseLocation() - GuiService:GetGuiInset()
end

local function inside(obj, pos)
	local p, sz = obj.AbsolutePosition, obj.AbsoluteSize
	return pos.X >= p.X and pos.X <= p.X + sz.X and pos.Y >= p.Y and pos.Y <= p.Y + sz.Y
end

-- A registered scroll frame counts when it is really on screen: it and every parent up to the
-- window are visible and the mouse is inside their bounds (so clipped lists don't steal the wheel).
local function frameUnderMouse(f, pos)
	local node = f
	while node and node ~= main do
		if node:IsA("GuiObject") and (not node.Visible or not inside(node, pos)) then
			return false
		end
		node = node.Parent
	end
	return node == main
end

local function scrollWheel(input)
	local pos = mouseGuiPos()
	if not inside(main, pos) then return end

	local candidates = {}
	for f in pairs(wheelFrames) do
		if frameUnderMouse(f, pos) then
			table.insert(candidates, f)
		end
	end

	-- deepest scrolling frame first (an open dropdown list wins over the tab panel)
	table.sort(candidates, function(a, b)
		return depthOf(a) > depthOf(b)
	end)
	for _, f in ipairs(candidates) do
		local maxY = f.AbsoluteCanvasSize.Y - f.AbsoluteWindowSize.Y
		if maxY > 1 then
			local info = wheelFrames[f]
			local base = info.tween and info.target or f.CanvasPosition.Y
			local dir = (input.Position.Z > 0) and -1 or 1
			local target = math.clamp(base + dir * info.step, 0, maxY)
			if info.tween then info.tween:Cancel() end
			local tw = TweenService:Create(f, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				CanvasPosition = Vector2.new(0, target),
			})
			info.tween = tw
			info.target = target
			tw.Completed:Once(function()
				if info.tween == tw then info.tween = nil end
			end)
			tw:Play()
			break
		end
	end
end

-- UserInputService still reports the wheel when the mouse is over a button
-- (buttons "process" the input, which is why ContextActionService alone missed it)
table.insert(connections, UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		scrollWheel(input)
	end
end))

-- Only used to stop the camera from zooming while the mouse is over the window
pcall(function()
	ContextActionService:BindActionAtPriority(WHEEL_ACTION, function()
		if inside(main, mouseGuiPos()) then
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value, Enum.UserInputType.MouseWheel)
end)

