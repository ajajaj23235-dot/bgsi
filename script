local equippedKnown = true
local function refreshPets()
	local ids = getEquippedIds()
	equippedKnown = ids ~= nil
	if not ids then
		-- fallback: every pet we've seen enchants on
		ids = {}
		for id, p in pairs(pets) do
			if p.Enchants then table.insert(ids, id) end
		end
	end

	table.sort(ids, function(a, b)
		local la = pets[a] and petLabel(pets[a]) or a
		local lb = pets[b] and petLabel(pets[b]) or b
		if la == lb then return a < b end
		return la < lb
	end)

	local parts = {}
	for _, id in ipairs(ids) do
		local p = pets[id]
		table.insert(parts, id .. (p and enchantText(p) or "?"))
	end
	local sig = table.concat(parts, "|")

	if sig ~= currentSig then
		currentSig = sig
		currentIds = ids

		local stillThere = false
		for _, id in ipairs(ids) do
			if id == selectedId then stillThere = true break end
		end
		if not stillThere then selectedId = ids[1] end

		updatePetText()
		buildPetList()
		renderSlots()
		if petDDOpen then setPetOpen(true) end
	end
	return #ids
end

