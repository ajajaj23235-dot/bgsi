	label.Font = FONT_MAIN
	label.TextSize = big and 20 or 16
	label.TextColor3 = TEXT_DARK
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Text = string.upper(labelText)
	label.ZIndex = 7
