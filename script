---------------------------------------------------------------------
-- Tweening
---------------------------------------------------------------------
local currentTween

local function cancelTween()
	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end
end

local function tweenTo(target)
	local hrp = getHRP()
	if not hrp then return end

	cancelTween()

	local distance = (hrp.Position - target).Magnitude
	local duration = math.clamp(distance / TWEEN_SPEED, MIN_TIME, MAX_TIME)
	local rotation = hrp.CFrame - hrp.CFrame.Position

	hrp.Anchored = true
	local tween = TweenService:Create(
		hrp,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = CFrame.new(target) * rotation }
	)
	currentTween = tween
	tween:Play()
	tween.Completed:Wait()
	if currentTween == tween then
		currentTween = nil
	end
	if hrp.Parent then
		hrp.Anchored = false
	end
end

